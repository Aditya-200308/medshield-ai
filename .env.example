# ═══════════════════════════════════════════════════════════════
# MedShield AI — Environment Configuration Template
# Copy this file to .env and configure your AWS credentials
# ═══════════════════════════════════════════════════════════════

# AWS Credentials (Configure via AWS IAM or AWS CLI)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=58cb26t3u7u9
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Amazon Redshift Serverless Configuration
REDSHIFT_WORKGROUP=medshield-workgroup
REDSHIFT_DATABASE=medshield_db
REDSHIFT_SCHEMA=clinical

# Amazon S3 Document Lakehouse
S3_BUCKET_NAME=medshield-clinical-723370474144
